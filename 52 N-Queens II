class Solution {
    public int totalNQueens(int n) {
        return solve(0, n, new boolean[n], new boolean[2 * n], new boolean[2 * n]);
    }

    public int solve(int row, int n, boolean[] col, boolean[] d1, boolean[] d2) {
        if (row == n) {
            return 1;
        }

        int count = 0;

        for (int j = 0; j < n; j++) {
            if (!col[j] && !d1[row + j] && !d2[row - j + n]) {
                col[j] = true;
                d1[row + j] = true;
                d2[row - j + n] = true;

                count += solve(row + 1, n, col, d1, d2);

                col[j] = false;
                d1[row + j] = false;
                d2[row - j + n] = false;
            }
        }

        return count;
    }
}
